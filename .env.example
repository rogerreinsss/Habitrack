# Copia este archivo a .env.local y ajusta los valores a tu dominio real.
#
# NEXT_PUBLIC_SITE_URL se usa para canonical, Open Graph, sitemap y robots.
# NEXT_PUBLIC_CONTACT_EMAIL aparece en la política de privacidad y security.txt.
NEXT_PUBLIC_SITE_URL=https://habitrack.app
NEXT_PUBLIC_CONTACT_EMAIL=privacidad@habitrack.app
